---
import { site } from '../data/site';
---
<section class="bg-ink text-paper">
	<div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-3">
		{site.testimonials.map((t) => (
			<figure>
				<blockquote class="font-display text-lg leading-snug">“{t.quote}”</blockquote>
				<figcaption class="mt-4 text-sm text-paper/70">{t.name}, {t.role}</figcaption>
			</figure>
		))}
	</div>
</section>
