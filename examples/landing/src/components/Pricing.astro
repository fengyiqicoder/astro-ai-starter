---
import { site } from '../data/site';
---
<section id="pricing" class="border-t border-line">
	<div class="mx-auto max-w-6xl px-5 py-16">
		<h2 class="font-display text-3xl font-bold tracking-tight">Pricing</h2>
		<p class="mt-2 text-ink-soft">Monthly, cancel any time. Paid plans start with 30 days free.</p>
		<div class="mt-8 grid gap-5 md:grid-cols-3">
			{site.pricing.map((p) => (
				<div class:list={['rounded-none border p-6', p.featured ? 'border-glass bg-white -[0_0_0_3px_#d8f0ec]' : 'border-line bg-white']}>
					<h3 class="font-display text-xl font-semibold">{p.name}</h3>
					<p class="mt-3"><span class="font-display text-4xl font-bold">{p.price}</span> <span class="text-ink-soft">{p.period}</span></p>
					<p class="mt-2 text-sm text-ink-soft">{p.line}</p>
					<ul class="mt-5 space-y-2 text-[15px]">
						{p.items.map((it) => <li class="flex gap-2"><span aria-hidden="true" class="text-glass-deep">✓</span>{it}</li>)}
					</ul>
					<a href="#contact" class:list={['mt-6 block rounded-none px-4 py-2 text-center text-sm font-semibold', p.featured ? 'bg-glass text-white hover:bg-glass-deep' : 'border border-ink text-ink hover:bg-paper-deep']}>{p.cta}</a>
				</div>
			))}
		</div>
	</div>
</section>
