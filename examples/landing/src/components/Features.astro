---
import { site } from '../data/site';
---
<section id="features" class="mx-auto max-w-6xl px-5 py-16">
	<h2 class="font-display text-3xl font-bold tracking-tight">What you get</h2>
	<dl class="mt-8 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
		{site.features.map((f) => (
			<div>
				<dt class="font-display text-lg font-semibold">{f.title}</dt>
				<dd class="mt-1 leading-relaxed text-ink-soft">{f.text}</dd>
			</div>
		))}
	</dl>
</section>
