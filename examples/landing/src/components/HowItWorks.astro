---
import { site } from '../data/site';
---
<section id="how" class="border-t border-line bg-paper-deep/60">
	<div class="mx-auto max-w-6xl px-5 py-16">
		<h2 class="font-display text-3xl font-bold tracking-tight">How it works</h2>
		<ol class="mt-8 grid gap-8 md:grid-cols-3">
			{site.how.map((step, i) => (
				<li class="border-l-2 border-glass pl-5">
					<p class="font-display text-sm font-semibold text-glass-deep">Step {i + 1}</p>
					<h3 class="mt-1 font-display text-xl font-semibold">{step.title}</h3>
					<p class="mt-2 leading-relaxed text-ink-soft">{step.text}</p>
				</li>
			))}
		</ol>
	</div>
</section>
