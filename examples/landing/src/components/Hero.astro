---
import { site } from '../data/site';
---
<section id="top" class="mx-auto grid max-w-6xl items-start gap-10 px-5 pb-16 pt-10 md:grid-cols-[1.15fr_1fr] md:pt-16">
	<div>
		<h1 class="font-display text-[clamp(38px,6vw,64px)] font-bold leading-[1.02] tracking-[-0.02em] text-balance">{site.hero.headline}</h1>
		<p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-ink-soft">{site.hero.sub}</p>
		<div class="mt-8 flex flex-wrap items-center gap-4">
			<a href={site.cta.href} class="rounded-none bg-glass px-5 py-3 font-semibold text-white hover:bg-glass-deep">{site.cta.label}</a>
			<a href="#how" class="text-ink-soft underline decoration-glass decoration-2 underline-offset-4 hover:text-ink">See how it works</a>
		</div>
	</div>

	<fit-check class="block rounded-none border border-line bg-white p-5 -[0_1px_0_#d5dbd6]">
		<p class="font-display text-lg font-semibold">Is {site.name} a fit for you?</p>
		<p class="mt-1 text-sm text-ink-soft">Say what you do and how you bill. The answer is written from this page, for you.</p>
		<form class="mt-4 flex flex-col gap-3" data-fit-form>
			<label class="sr-only" for="fit-input">Describe your situation</label>
			<textarea id="fit-input" name="situation" rows="3" maxlength="500" required placeholder="I'm a freelance designer. Four clients, two of them in the US, I bill in euros and chase late payments by hand." class="w-full resize-none rounded-none border border-line bg-paper px-3 py-2 text-[15px] leading-relaxed focus:border-glass"></textarea>
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs text-ink-soft">Nothing is stored. <a href="#how-ai" class="underline underline-offset-2">How this works</a></span>
				<button type="submit" data-fit-submit class="rounded-none bg-glass px-4 py-2 text-sm font-semibold text-white hover:bg-glass-deep disabled:opacity-60">Check fit</button>
			</div>
		</form>
		<p class="mt-3 min-h-5 text-sm text-ink-soft" data-fit-status aria-live="polite"></p>
		<div class="mt-2 hidden rounded-none bg-glass-wash p-4" data-fit-result>
			<p class="font-display text-base font-semibold" data-fit-verdict></p>
			<p class="mt-2 text-[15px] leading-relaxed" data-fit-why></p>
			<p class="mt-3 text-sm text-ink-soft"><span data-fit-plan></span> <a href="#pricing" class="underline underline-offset-2">See plans</a></p>
		</div>
	</fit-check>
</section>

<script>
	import { loadOneTag, describe } from '../scripts/onetag';

	// "Fit check": the visitor's situation plus the page's own copy go to the model, which
	// returns JSON. Nothing about the product is invented: the input is this page.
	class FitCheck extends HTMLElement {
		constructor() {
			super();
			const form = this.querySelector<HTMLFormElement>('[data-fit-form]')!;
			const status = this.querySelector<HTMLElement>('[data-fit-status]')!;
			const result = this.querySelector<HTMLElement>('[data-fit-result]')!;
			const submit = this.querySelector<HTMLButtonElement>('[data-fit-submit]')!;
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const situation = (form.elements.namedItem('situation') as HTMLTextAreaElement).value.trim();
				if (!situation) return;
				submit.disabled = true;
				result.classList.add('hidden');
				status.textContent = 'Reading the page…';
				try {
					const onetag = await loadOneTag();
					const page = document.querySelector('main')!;
					const data = await onetag.ask(
						'A visitor describes their situation below. Judge, from the product description on this page only, ' +
							'whether the product fits them. Reply with JSON: {"fit": "yes" | "partly" | "no", "verdict": one sentence addressed to the visitor, ' +
							'"why": two or three sentences naming the specific features, limits or prices on the page that matter for them, ' +
							'"plan": the name of the plan that suits them and why, in one sentence}. Reply in the language the visitor wrote in.\n\nVisitor: ' + situation,
						page,
						{ json: true, maxTokens: 350 }
					);
					status.textContent = '';
					this.querySelector<HTMLElement>('[data-fit-verdict]')!.textContent = String(data.verdict || '');
					this.querySelector<HTMLElement>('[data-fit-why]')!.textContent = String(data.why || '');
					this.querySelector<HTMLElement>('[data-fit-plan]')!.textContent = String(data.plan || '');
					result.classList.remove('hidden');
				} catch (err) {
					status.textContent = describe(err);
				} finally {
					submit.disabled = false;
				}
			});
		}
	}
	customElements.define('fit-check', FitCheck);
</script>
