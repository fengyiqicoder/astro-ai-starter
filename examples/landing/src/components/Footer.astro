---
import { site } from '../data/site';
---
<footer class="border-t border-line">
	<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-8 text-sm text-ink-soft">
		<p>{site.footer.company}</p>
		<nav class="flex gap-5" aria-label="Footer">
			{site.footer.links.map((l) => <a href={l.href} class="hover:text-ink">{l.label}</a>)}
		</nav>
		<p>Built with <a href="https://github.com/fengyiqicoder/astro-ai-starter" class="underline underline-offset-2">Astro AI Starter</a>. <a href="https://onetagai.com/?ref=astro-ai-starter" class="underline underline-offset-2">Powered by OneTag AI</a>: the fit check and the FAQ answer from this page, no backend.</p>
	</div>
</footer>
