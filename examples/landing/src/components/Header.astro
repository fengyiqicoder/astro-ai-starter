---
import { site } from '../data/site';
---
<header class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-5">
	<a href="#top" class="font-display text-xl font-bold tracking-tight">{site.name}</a>
	<nav aria-label="Main" class="hidden items-center gap-7 text-[15px] text-ink-soft md:flex">
		{site.nav.map((n) => <a href={n.href} class="hover:text-ink">{n.label}</a>)}
	</nav>
	<a href={site.cta.href} class="rounded-none bg-glass px-4 py-2 text-sm font-semibold text-white hover:bg-glass-deep">{site.cta.label}</a>
</header>
