---
import { site } from '../data/site';
const { endpoint } = site.contact;
---
<section id="contact" class="border-t border-line bg-glass-wash/60">
	<div class="mx-auto max-w-6xl px-5 py-16">
		<h2 class="font-display text-3xl font-bold tracking-tight">{site.contact.title}</h2>
		<p class="mt-2 max-w-[48ch] text-ink-soft">{site.contact.text}</p>
		<form class="mt-6 flex max-w-md flex-col gap-3 sm:flex-row" action={endpoint || undefined} method="post" data-contact-form data-has-endpoint={endpoint ? 'yes' : 'no'}>
			<label class="sr-only" for="contact-email">Email</label>
			<input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-w-0 flex-1 rounded-none border border-line bg-white px-3 py-2 text-[15px] focus:border-glass" />
			<button type="submit" class="rounded-none bg-glass px-5 py-2 font-semibold text-white hover:bg-glass-deep">Send me a link</button>
		</form>
		<p class="mt-3 min-h-5 text-sm text-ink-soft" data-contact-status aria-live="polite"></p>
	</div>
</section>

<script>
	// Without an endpoint in site.ts the form explains itself instead of posting into the void.
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const status = document.querySelector<HTMLElement>('[data-contact-status]');
	if (form && status && form.dataset.hasEndpoint === 'no') {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			status.textContent = 'Demo form: set contact.endpoint in src/data/site.ts to a form service to receive submissions.';
		});
	}
</script>
