---
// Starlight's footer plus the family signature line.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>
<p class="powered">Built with <a href="https://github.com/fengyiqicoder/astro-ai-starter">Astro AI Starter</a>. <a href="https://onetagai.com/?ref=astro-ai-starter">Powered by OneTag AI</a>: answers come from your own pages, no backend.</p>

<style>
	.powered { margin: 1rem 0 0; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.powered a { color: var(--sl-color-gray-2); font-weight: 600; text-decoration: none; }
	.powered a:hover { color: var(--sl-color-white); }
</style>
