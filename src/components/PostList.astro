---
import type { Post } from '../lib/posts';
import { formatDate, readingTime, tagSlug } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ul class="post-list">
	{posts.map((post) => (
		<li>
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
			<div>
				<h3><a href={`${base}/blog/${post.id}/`}>{post.data.title}</a></h3>
				<p>{post.data.description}</p>
				<div class="tags">
					{post.data.tags.map((t) => <a class="tag" href={`${base}/tags/${tagSlug(t)}/`}>{t}</a>)}
					<span class="tag">{readingTime(post.body)} min</span>
				</div>
			</div>
		</li>
	))}
</ul>
