---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagSlug } from '../../lib/posts';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Blog" description="All posts." narrow>
	<h1 class="page-title">Blog</h1>
	<p class="note" style="margin-bottom:24px">{posts.length} posts. {tags.map((t) => <a class="tag" href={`${base}/tags/${tagSlug(t)}/`} style="margin-right:6px">{t}</a>)}</p>
	<PostList posts={posts} />
</Base>
