---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Not found" narrow noindex>
	<h1 class="page-title">Page not found.</h1>
	<p class="lead">Try the <a href={`${base}/blog/`}>blog</a>, or press <kbd>Ctrl</kbd> <kbd>/</kbd> to ask the site where something went.</p>
</Base>
