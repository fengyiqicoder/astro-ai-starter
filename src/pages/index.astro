---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ReaderFit from '../components/ReaderFit.astro';
import { site, hasKey } from '../config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, 5);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base landing>
	<section>
		<div class="hero">
			<div>
				<h1><span class="light">{site.scene}</span>{site.tagline}</h1>
				<p class="lead">An Astro starter with AI built in. Every page can summarize itself, translate itself and answer your questions, from the browser, with no backend behind it. This demo is the blog; docs and landing page come in the same repo.</p>
				<nav class="bar" aria-label="Start">
					<a href={`${base}/blog/`}>Read the blog</a>
					<a href={site.repo}>Use this starter</a>
				</nav>
			</div>
			<ReaderFit />
		</div>
	</section>
	<section>
		<div class="section-head"><h2>Latest posts</h2><p>Open any post and try the TL;DR, Translate and Ask the author buttons at the top.{!hasKey && ' This demo has no AI key set yet, so the buttons will say so.'}</p></div>
		<PostList posts={posts} />
		<p style="margin-top:24px"><a class="button secondary" href={`${base}/blog/`}>All posts</a></p>
	</section>
	<section>
		<div class="section-head"><h2>Also in this repo</h2><p>The blog is the root project. Two more complete sites ship in <code>examples/</code>, with the same AI wiring and the same design tokens.</p></div>
		<ul class="cells">
			<li><span class="tag">blog</span><h3>Blog</h3><p>This site. Posts that summarize, translate and answer questions.</p><a class="link" href={`${base}/blog/`} style="display:inline-block;margin-top:24px;font-weight:600">Read it</a></li>
			<li><span class="tag">docs</span><h3>Docs: Lantern</h3><p>Starlight docs with an Ask AI dialog that answers from your own pages, using the Pagefind index.</p><a class="link" href={`${base}/docs/`} style="display:inline-block;margin-top:24px;font-weight:600">Open the demo</a></li>
			<li><span class="tag">landing</span><h3>Landing page: Pitch</h3><p>A product page where visitors check whether the product fits them, and an FAQ that answers follow-ups.</p><a class="link" href={`${base}/landing/`} style="display:inline-block;margin-top:24px;font-weight:600">Open the demo</a></li>
		</ul>
	</section>
</Base>
