---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ReaderFit from '../components/ReaderFit.astro';
import { site, hasKey } from '../config';
import { getPosts } from '../lib/posts';
const posts = (await getPosts()).slice(0, 5);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base landing>
	<section>
		<div class="hero">
			<div>
				<h1><span class="light">{site.scene}</span>{site.tagline}</h1>
				<p class="lead">An Astro starter with AI built in. Every page can summarize itself, translate itself and answer your questions, from the browser, with no backend behind it. This demo is the blog; docs and landing page come in the same repo.</p>
				<nav class="bar" aria-label="Start">
					<a href={`${base}/blog/`}>Read the blog</a>
					<a href={site.repo}>Use this starter</a>
				</nav>
			</div>
			<ReaderFit />
		</div>
	</section>
	<section>
		<div class="section-head"><h2>Latest posts</h2><p>Open any post and try the TL;DR, Translate and Ask the author buttons at the top.{!hasKey && ' This demo has no AI key set yet, so the buttons will say so.'}</p></div>
		<PostList posts={posts} />
		<p style="margin-top:24px"><a class="button secondary" href={`${base}/blog/`}>All posts</a></p>
	</section>
</Base>
