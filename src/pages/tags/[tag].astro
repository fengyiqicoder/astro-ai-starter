---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
	return tags.map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---

<Base title={`Tag: ${tag}`} description={`Posts tagged ${tag}.`} narrow>
	<h1 class="page-title">Tag: {tag}</h1>
	<PostList posts={posts} />
</Base>
